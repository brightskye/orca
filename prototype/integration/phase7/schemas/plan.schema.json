{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orca:phase7:curator-plan:v1",
  "title": "Orca Phase 7 Curator plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "integration", "generated_at", "event_id",
    "intake_id", "intake_reference", "candidate_revision", "comparison_class",
    "proposed_disposition", "canonical_target", "proposed_action",
    "evidence_references", "rationale", "authority_requirement",
    "source_precondition", "canonical_precondition", "curator", "plan_id",
    "disposition_id"
  ],
  "properties": {
    "schema": {"const": "orca-phase7-curator-plan"},
    "schema_version": {"const": 1},
    "integration": {"const": {"name": "orca-cairn-curator-intake", "version": "0.1.4"}},
    "generated_at": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "pattern": "^phase7-event:[0-9a-f]{64}$"},
    "intake_id": {"type": "string", "pattern": "^phase7-intake:[0-9a-f]{64}$"},
    "intake_reference": {"type": "string", "minLength": 1},
    "candidate_revision": {
      "type": "object", "additionalProperties": false,
      "required": ["permalink", "previous_sha256", "current_sha256", "change"],
      "properties": {
        "permalink": {"type": "string", "minLength": 1},
        "previous_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "current_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "change": {"enum": ["added", "changed", "deleted"]}
      }
    },
    "comparison_class": {"type": "string", "minLength": 1},
    "proposed_disposition": {"enum": ["consumed", "rejected", "merged", "promoted", "superseded"]},
    "canonical_target": {"type": ["string", "null"]},
    "proposed_action": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "none"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "content"], "properties": {"kind": {"const": "write_markdown"}, "content": {"type": "string"}}}
      ]
    },
    "evidence_references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rationale": {"type": "string", "minLength": 1},
    "authority_requirement": {"enum": ["curator", "human"]},
    "source_precondition": {
      "type": "object", "additionalProperties": false,
      "required": ["permalink", "expected_state", "expected_revision"],
      "properties": {
        "permalink": {"type": "string", "minLength": 1},
        "expected_state": {"enum": ["present", "absent"]},
        "expected_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "canonical_precondition": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_sha256", "planned_sha256"],
      "properties": {
        "expected_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "planned_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "curator": {"const": {"skill": "orca-curator/0.2", "semantic_judgment": "external"}},
    "plan_id": {"type": "string", "pattern": "^phase7-plan:[0-9a-f]{64}$"},
    "disposition_id": {"type": "string", "pattern": "^phase7-disposition:[0-9a-f]{64}$"}
  }
}
