{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orca:phase6:delta-result:v1",
  "title": "Orca Cairn delta result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "adapter",
    "source_store",
    "generated_at",
    "checkpoint",
    "summary",
    "deltas"
  ],
  "properties": {
    "schema": {"const": "orca-cairn-delta-result"},
    "schema_version": {"const": 1},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "orca-cairn-delta"},
        "version": {"const": "0.1.2"}
      }
    },
    "source_store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "harness", "default_intent"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "harness": {"type": "string", "minLength": 1},
        "default_intent": {"enum": ["explicit", "implicit"]}
      }
    },
    "generated_at": {"type": "string", "minLength": 1},
    "checkpoint": {
      "type": "object",
      "required": ["previous_id", "current_id", "initial_discovery"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "changed", "deleted", "unchanged"],
      "properties": {
        "added": {"type": "integer", "minimum": 0},
        "changed": {"type": "integer", "minimum": 0},
        "deleted": {"type": "integer", "minimum": 0},
        "unchanged": {"type": "integer", "minimum": 0}
      }
    },
    "deltas": {
      "type": "array",
      "items": {"$ref": "#/$defs/delta"}
    }
  },
  "$defs": {
    "delta": {
      "type": "object",
      "required": [
        "change",
        "permalink",
        "previous_sha256",
        "current_sha256",
        "content_sha256",
        "source_reference",
        "previous_source_reference",
        "adapter_version",
        "checkpoint_id",
        "harness",
        "intent",
        "entry_mode",
        "authority",
        "orca_state",
        "generated",
        "sources",
        "provenance"
      ],
      "properties": {
        "change": {"enum": ["added", "changed", "deleted"]},
        "permalink": {"type": "string", "minLength": 1},
        "previous_sha256": {"type": ["string", "null"]},
        "current_sha256": {"type": ["string", "null"]},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content": {"type": "string"},
        "source_reference": {"type": ["string", "null"]},
        "previous_source_reference": {"type": ["string", "null"]},
        "adapter_version": {"const": "0.1.2"},
        "checkpoint_id": {"type": "string", "pattern": "^phase6:[0-9a-f]{64}$"},
        "harness": {"type": "string", "minLength": 1},
        "intent": {"enum": ["explicit", "implicit"]},
        "entry_mode": {"enum": ["explicit", "implicit", "conversational", "source", "reflection"]},
        "authority": {"const": "candidate"},
        "orca_state": {"const": "new"},
        "generated": {"type": "object"},
        "sources": {"type": "array", "minItems": 1},
        "provenance": {"type": "object"},
        "semantics": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"change": {"const": "deleted"}}},
          "then": {"not": {"required": ["content"]}},
          "else": {"required": ["content"]}
        }
      ]
    }
  }
}
